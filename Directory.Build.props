<?xml version="1.0" encoding="utf-8"?>
<Project>
	<PropertyGroup>
		
		<!-- Changing these values will affect how the plugin is generated -->
		
		<!-- ComicRack install path, will be used to locate the ComicRack.Plugins & ComicRack.Engine library -->
		<ComicRackPath>C:\Program Files\ComicRack Community Edition</ComicRackPath>
		
		<!-- Your script folder location, relevant files will be copied in that location -->
		<ScriptFolder>$(AppData)\cYo\ComicRack Community Edition\Scripts</ScriptFolder>

		<!-- Change to true to copy source files instead of the compiled plugin -->
		<IsSourcePlugin>false</IsSourcePlugin>
		
		<!-- Copy the Resources images with the plugin. This is always true when IsSourcePlugin is true -->
		<CopyResourcesImage>true</CopyResourcesImage>
		
	</PropertyGroup>


	<!-- Make sure .pdb are created when in debug configuration -->
	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<DebugType>portable</DebugType>
	</PropertyGroup>
	

	<!-- ComicRack library references, will use the above ComicRackPath property to locate them -->
	<ItemGroup>
		<Reference Include="ComicRack.Engine">
			<HintPath>$(ComicRackPath)\ComicRack.Engine.dll</HintPath>
			<Private>false</Private> <!-- Don't copy to output folder -->
		</Reference>
		<Reference Include="ComicRack.Plugins">
			<HintPath>$(ComicRackPath)\ComicRack.Plugins.dll</HintPath>
			<Private>false</Private> <!-- Don't copy to output folder -->
		</Reference>
	</ItemGroup>


	<!-- This enables new language features not available normally in .NET Framework v4.8 -->
	<PropertyGroup>
		<LangVersion>14.0</LangVersion>
		<Platform>AnyCPU</Platform>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="PolySharp">
			<Version>1.16.0</Version>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

</Project>
